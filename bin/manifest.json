{
	"manifest_version": 3,
	"name": "linkcart",
	"description": "Linkcart allows you to shortlist multiple tabs so you can copy all tabs urls( links ) at once.",
	"version": "1.2.0",
	"icons": {
		"128": "images/icons/icon-128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_icon": "images/icons/icon.png",
		"default_popup": "views/popup.html",
		"default_title": "linkcart"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"permissions": ["activeTab", "contextMenus", "storage", "bookmarks"]
}
